@model Vehicle

<a asp-action="Index" class="invoice-back-link">
    <i class="bi bi-arrow-left"></i> Return to vehicles
</a>

<div class="book-wrapper">
    <div class="book-card">
        <h5 class="book-title">Add Vehicle</h5>

        <form asp-action="Create" method="post">

            <div class="mb-3">
                <label class="book-field-label">Make</label>
                <input asp-for="Make" class="form-control form-control-sm" placeholder="Toyota" />
            </div>

            <div class="mb-3">
                <label class="book-field-label">Model</label>
                <input asp-for="Model" class="form-control form-control-sm" placeholder="Camry" />
            </div>

            <div class="mb-3">
                <label class="book-field-label">Year</label>
                <input asp-for="Year" type="number" class="form-control form-control-sm input-year" placeholder="2024" />
            </div>

            <div class="mb-3">
                <label class="book-field-label">Price Per Day</label>
                <div class="input-group input-group-sm input-price-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="PricePerDay" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-secondary btn-sm">Cancel</a>
                <button type="submit" class="btn btn-primary btn-sm px-4">Save</button>
            </div>

        </form>
    </div>
</div>
