@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="book-wrapper">
    <div class="book-card text-center">
        <div class="error-icon">⚠️</div>
        <h5 class="book-title mb-1">Something went wrong</h5>
        <p class="text-muted-sm mb-4">An error occurred while processing your request.</p>

        @if (Model.ShowRequestId)
        {
            <p class="form-hint-muted">Request ID: <code>@Model.RequestId</code></p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-sm">Back to Dashboard</a>
    </div>
</div>
