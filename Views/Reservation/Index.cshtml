@model IEnumerable<Reservation>

<div class="row mb-4">
    <div class="col-md-8">
        <h1 class="mb-0">Reservations</h1>
    </div>
    <div class="col-md-4 text-end">
        <a class="btn btn-success" asp-action="Create">+ Add Reservation</a>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-primary">
            <tr>
                <th>ID</th>
                <th>Vehicle</th>
                <th>Customer</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Total Cost</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Vehicle?.Make @item.Vehicle?.Model</td>
                    <td>@item.Customer?.FullName</td>
                    <td>@item.StartDate.ToShortDateString()</td>
                    <td>@item.EndDate.ToShortDateString()</td>
                    <td><strong>$@item.TotalCost.ToString("F2")</strong></td>
                    <td>
                        <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>