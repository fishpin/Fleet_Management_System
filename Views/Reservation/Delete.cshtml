@model Reservation

<h2>Delete Reservation</h2>

<div class="alert alert-danger" role="alert">
    <p>Are you sure you want to delete this reservation?</p>
</div>

<div class="card">
    <div class="card-body">
        <p><strong>Vehicle:</strong> @Model.Vehicle?.Make @Model.Vehicle?.Model (@Model.Vehicle?.Year)</p>
        <p><strong>Customer:</strong> @Model.Customer?.FullName</p>
        <p><strong>Start Date:</strong> @Model.StartDate.ToShortDateString()</p>
        <p><strong>End Date:</strong> @Model.EndDate.ToShortDateString()</p>
        <p><strong>Total Cost:</strong> $@Model.TotalCost.ToString("F2")</p>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>