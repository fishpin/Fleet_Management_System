@model Reservation

<a asp-action="Index" class="invoice-back-link">
    <i class="bi bi-arrow-left"></i> Return to reservations
</a>

<div class="book-wrapper">
    <div class="book-card">
        <h5 class="book-title">Delete Reservation</h5>

        <div class="book-pricing mb-4">
            <div class="pricing-row">
                <span>Customer</span>
                <span class="pricing-value">@Model.Customer?.FullName</span>
            </div>
            <div class="pricing-row">
                <span>Vehicle</span>
                <span class="pricing-value">@Model.Vehicle?.Year @Model.Vehicle?.Make @Model.Vehicle?.Model</span>
            </div>
            <div class="pricing-row">
                <span>Rental Period</span>
                <span class="pricing-value">@Model.StartDate.ToString("MMM d, yyyy") &ndash; @Model.EndDate.ToString("MMM d, yyyy")</span>
            </div>
            <div class="pricing-row pricing-total">
                <span>Total Cost</span>
                <span>$@Model.TotalCost.ToString("F2")</span>
            </div>
        </div>

        <p class="text-muted-sm">This action cannot be undone.</p>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary btn-sm">Cancel</a>
                <button type="submit" class="btn btn-danger btn-sm">Delete Reservation</button>
            </div>
        </form>
    </div>
</div>
