@model Reservation

<a asp-action="Index" class="invoice-back-link">
    <i class="bi bi-arrow-left"></i> Return to reservations
</a>

<div class="book-wrapper">
    <div class="book-card">
        <h5 class="book-title">Edit Reservation</h5>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="All" class="alert dashboard-alert mb-3" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

            <div class="mb-3">
                <label class="book-field-label">Vehicle</label>
                <select asp-for="VehicleId" class="form-select form-select-sm">
                    <option value="">Choose a vehicle...</option>
                    @foreach (var v in (List<Vehicle>)ViewBag.Vehicles)
                    {
                        <option value="@v.Id">@v.Year @v.Make @v.Model</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="book-field-label">Customer</label>
                <select asp-for="CustomerId" class="form-select form-select-sm">
                    <option value="">Choose a customer...</option>
                    @foreach (var c in (List<Customer>)ViewBag.Customers)
                    {
                        <option value="@c.Id">@c.FullName</option>
                    }
                </select>
            </div>

            <div class="book-dates-row mb-3">
                <div>
                    <label class="book-field-label">From Date</label>
                    <input asp-for="StartDate" type="date" class="form-control form-control-sm" />
                </div>
                <div>
                    <label class="book-field-label">To Date</label>
                    <input asp-for="EndDate" type="date" class="form-control form-control-sm" />
                </div>
            </div>

            <div class="mb-3">
                <label class="book-field-label">Insurance Coverage</label>
                <div class="d-flex align-items-center gap-2 mt-1">
                    <input asp-for="IncludesInsurance" type="checkbox" class="form-check-input mt-0" />
                    <span class="form-hint">+$25/day</span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-secondary btn-sm">Cancel</a>
                <button type="submit" class="btn btn-primary btn-sm px-4">Save</button>
            </div>

        </form>
    </div>
</div>
