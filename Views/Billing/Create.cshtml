@model Billing

@{
    var reservations = (IEnumerable<Reservation>)ViewBag.Reservations;
}

<div class="book-wrapper">
    <div class="book-card">
        <h5 class="book-title">Add Invoice</h5>

        <form asp-action="Create" method="post">

            <div asp-validation-summary="All" class="alert dashboard-alert mb-3" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

            <div class="mb-3">
                <label class="book-field-label">Reservation</label>
                <select asp-for="ReservationId" class="form-select form-select-sm">
                    <option value="">Choose a reservation...</option>
                    @foreach (var r in reservations)
                    {
                        <option value="@r.Id" selected="@(Model.ReservationId == r.Id)">
                            RES-@r.Id.ToString("D4") — @r.Customer?.FullName &bull; @r.Vehicle?.Make @r.Vehicle?.Model
                            (@r.StartDate.ToString("MMM d") &rarr; @r.EndDate.ToString("MMM d, yyyy"))
                        </option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="book-field-label" asp-for="ExtraCharges">Extra Charges</label>
                <input asp-for="ExtraCharges" type="number" step="0.01" min="0"
                       class="form-control form-control-sm input-price-group" placeholder="0.00" />
                <div class="form-hint-muted mt-1">Tax (12.5%) is calculated automatically.</div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-secondary btn-sm">Cancel</a>
                <button type="submit" class="btn btn-primary btn-sm px-4">Create Invoice</button>
            </div>
        </form>
    </div>
</div>
