@model Billing

@{
    var r = Model.Reservation;
}

<div class="book-wrapper">
    <div class="book-card">
        <h5 class="book-title">Delete Invoice</h5>

        <div class="alert dashboard-alert mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            This will permanently delete the invoice for Reservation #@Model.ReservationId.
        </div>

        <div class="book-pricing">
            <div class="pricing-row">
                <span>Customer</span>
                <span class="pricing-value">@r?.Customer?.FullName</span>
            </div>
            <div class="pricing-row">
                <span>Vehicle</span>
                <span class="pricing-value">@r?.Vehicle?.Make @r?.Vehicle?.Model</span>
            </div>
            <div class="pricing-row">
                <span>Tax</span>
                <span class="pricing-value">$@Model.Tax.ToString("F2")</span>
            </div>
            <div class="pricing-row">
                <span>Extra Charges</span>
                <span class="pricing-value">$@Model.ExtraCharges.ToString("F2")</span>
            </div>
            <div class="pricing-row pricing-total">
                <span>Final Amount</span>
                <span>$@Model.FinalAmount.ToString("F2")</span>
            </div>
        </div>

        <form asp-action="Delete" method="post" class="mt-4">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary btn-sm">Cancel</a>
                <button type="submit" class="btn btn-danger btn-sm">Delete Invoice</button>
            </div>
        </form>
    </div>
</div>
