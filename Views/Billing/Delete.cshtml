@model Billing

<h2>Delete Invoice</h2>

<div class="alert alert-danger" role="alert">
    <p>Are you sure you want to delete this invoice?</p>
</div>

<div class="card">
    <div class="card-body">
        <p><strong>Reservation ID:</strong> @Model.ReservationId</p>
        <p><strong>Tax:</strong> $@Model.Tax.ToString("F2")</p>
        <p><strong>Extra Charges:</strong> $@Model.ExtraCharges.ToString("F2")</p>
        <p><strong>Final Amount:</strong> $@Model.FinalAmount.ToString("F2")</p>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>