@model IEnumerable<Billing>
<h2>Billing</h2>
<a asp-action="Create">Create New</a>
<table class="table">
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ReservationId</td>
            <td>@item.Tax</td>
            <td>@item.ExtraCharges</td>
            <td>@item.FinalAmount</td>
        </tr>
    }
</table>
