@model IEnumerable<Customer>

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="page-heading">Customers</h2>
    <a class="btn btn-sm btn-primary" asp-action="Create">+ Add Customer</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon">👤</div>
        <p class="mb-0">No customers yet. <a asp-action="Create" class="fw-bold text-dark">Add one to get started</a></p>
    </div>
}
else
{
    @foreach (var item in Model)
    {
        <div class="customer-card">
            <div class="customer-avatar">@item.FullName.Substring(0, 1).ToUpper()</div>
            <div class="customer-info">
                <div class="customer-name">@item.FullName</div>
                <div class="customer-meta">
                    @item.Phone
                    @if (!string.IsNullOrEmpty(item.Phone) && !string.IsNullOrEmpty(item.Email))
                    {
                        <span>&nbsp;&bull;&nbsp;</span>
                    }
                    @item.Email
                </div>
            </div>
            <div class="customer-actions">
                <a class="btn btn-sm btn-primary" asp-controller="Reservation" asp-action="Create">Book</a>
                <a class="btn-icon btn-icon-edit" asp-action="Edit" asp-route-id="@item.Id" title="Edit">
                    <i class="bi bi-pencil-fill"></i>
                </a>
                <a class="btn-icon btn-icon-delete" asp-action="Delete" asp-route-id="@item.Id" title="Delete">
                    <i class="bi bi-trash-fill"></i>
                </a>
            </div>
        </div>
    }
}
