@model Customer

<a asp-action="Index" class="invoice-back-link">
    <i class="bi bi-arrow-left"></i> Return to customers
</a>

<div class="book-wrapper">
    <div class="book-card">
        <h5 class="book-title">Delete Customer</h5>

        <div class="book-pricing mb-4">
            <div class="pricing-row">
                <span>Full Name</span>
                <span class="pricing-value">@Model.FullName</span>
            </div>
            <div class="pricing-row">
                <span>Email</span>
                <span class="pricing-value">@Model.Email</span>
            </div>
            <div class="pricing-row">
                <span>Phone</span>
                <span class="pricing-value">@Model.Phone</span>
            </div>
        </div>

        @if (TempData["DeleteError"] != null)
        {
            <div class="alert dashboard-alert mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @TempData["DeleteError"]
            </div>
        }

        <p class="text-muted-sm">This action cannot be undone.</p>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary btn-sm">Cancel</a>
                <button type="submit" class="btn btn-danger btn-sm">Delete Customer</button>
            </div>
        </form>
    </div>
</div>
