@model Customer

<a asp-action="Index" class="invoice-back-link">
    <i class="bi bi-arrow-left"></i> Return to customers
</a>

<div class="book-wrapper">
    <div class="book-card">
        <h5 class="book-title">Edit Customer</h5>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="book-field-label">Full Name</label>
                <input asp-for="FullName" class="form-control form-control-sm" />
            </div>

            <div class="mb-3">
                <label class="book-field-label">Email</label>
                <input asp-for="Email" type="email" class="form-control form-control-sm" />
            </div>

            <div class="mb-3">
                <label class="book-field-label">Phone</label>
                <input asp-for="Phone" type="tel" class="form-control form-control-sm" />
            </div>

            <div class="mb-3">
                <label class="book-field-label">Address</label>
                <input asp-for="Address" class="form-control form-control-sm" />
            </div>

            <div class="mb-3">
                <label class="book-field-label">Driver's License #</label>
                <input asp-for="LicenseNumber" class="form-control form-control-sm" />
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-secondary btn-sm">Cancel</a>
                <button type="submit" class="btn btn-primary btn-sm px-4">Save</button>
            </div>

        </form>
    </div>
</div>
