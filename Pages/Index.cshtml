@page
@model IndexModel
@{
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fleet Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <div class="container">
        <div class="row justify-content-center mt-5">
            <div class="col-md-6">
                <div class="card shadow-lg">
                    <div class="card-body p-5">
                        <h1 class="card-title text-center mb-4">🚗 Fleet Management System</h1>
                        <h5 class="text-center text-muted mb-4">Sign In</h5>

                        <form method="post">
                            @if (!ModelState.IsValid && ModelState.ErrorCount > 0)
                            {
                                <div class="alert alert-danger" role="alert">
                                    @foreach (var modelState in ViewData.ModelState.Values)
                                    {
                                        @foreach (var error in modelState.Errors)
                                        {
                                            <p class="mb-1">@error.ErrorMessage</p>
                                        }
                                    }
                                </div>
                            }

                            <div class="mb-3">
                                <label for="email" class="form-label">Email Address</label>
                                <input type="email" id="email" name="Email" class="form-control" placeholder="Enter your email" required />
                            </div>

                            <div class="mb-3">
                                <label for="password" class="form-label">Password</label>
                                <input type="password" id="password" name="Password" class="form-control" placeholder="Enter your password" required />
                            </div>

                            <button type="submit" class="btn btn-primary w-100">Sign In</button>
                        </form>

                        <hr class="my-4" />

                        <div class="text-center">
                            <p class="mb-2">Don't have an account? <a href="/Register" class="fw-bold">Sign Up Here</a></p>
                            <p class="text-muted"><small>Demo Credentials:<br/>Email: user@example.com<br/>Password: Test@123</small></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>